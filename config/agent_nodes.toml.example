[supervisor]
model = "gemini-2.5-flash"
temperature = 0.7
provider = "google"

# A factory node — model and temperature are injected from config
[[nodes]]
name = "my_custom_agent"
adapter = "python"
callable = "my_team_agents.custom:create_my_custom_node"
model = "gemini-2.5-flash"
temperature = 0.0
provider = "google"
enabled = true
 